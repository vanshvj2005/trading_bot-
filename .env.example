# Binance Futures DEMO/TESTNET API credentials.
# Copy this file to ".env" and fill in keys generated at https://demo.binance.com
# (API Management -> Create API -> System Generated).
#
# SAFETY: These MUST be Demo/Testnet keys. Never put production Binance keys
# here. The .env file is gitignored and must never be committed.

API_KEY=your_demo_testnet_api_key_here
API_SECRET=your_demo_testnet_api_secret_here
